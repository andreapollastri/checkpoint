{
  "name": "andreapollastri/checkpoint",
  "description": "Laravel security scanner — checks CVEs, hardcoded secrets, SQL injection, XSS and more via a single Artisan command.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/andreapollastri/checkpoint",
  "authors": [
    {
      "name": "Andrea Pollastri",
      "homepage": "https://andreapollastri.net",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/andreapollastri/checkpoint/issues",
    "source": "https://github.com/andreapollastri/checkpoint",
    "docs": "https://github.com/andreapollastri/checkpoint#readme",
    "security": "https://github.com/andreapollastri/checkpoint/security/advisories"
  },
  "require": {
    "php": "^8.1",
    "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "symfony/finder": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^9.5.10 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Checkpoint\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Checkpoint\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Checkpoint\\CheckpointServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
